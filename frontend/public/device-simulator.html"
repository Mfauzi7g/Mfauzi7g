<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Screen Time - Child Device Simulator</title>\n    <script src=\"https://cdn.socket.io/4.7.4/socket.io.min.js\"></script>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        \n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            min-height: 100vh;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            padding: 20px;\n        }\n        \n        .device-frame {\n            width: 375px;\n            height: 667px;\n            background: #000;\n            border-radius: 36px;\n            padding: 8px;\n            box-shadow: 0 20px 60px rgba(0,0,0,0.3);\n        }\n        \n        .screen {\n            width: 100%;\n            height: 100%;\n            background: #f8f9fa;\n            border-radius: 28px;\n            overflow: hidden;\n            position: relative;\n        }\n        \n        .status-bar {\n            height: 44px;\n            background: #1976D2;\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            padding: 0 20px;\n            color: white;\n            font-size: 14px;\n            font-weight: 600;\n        }\n        \n        .connection-status {\n            display: flex;\n            align-items: center;\n            gap: 8px;\n        }\n        \n        .status-dot {\n            width: 8px;\n            height: 8px;\n            border-radius: 50%;\n            background: #4CAF50;\n        }\n        \n        .status-dot.offline {\n            background: #f44336;\n        }\n        \n        .content {\n            padding: 20px;\n            height: calc(100% - 44px);\n            overflow-y: auto;\n        }\n        \n        .pairing-section {\n            background: white;\n            border-radius: 12px;\n            padding: 20px;\n            margin-bottom: 20px;\n            box-shadow: 0 2px 8px rgba(0,0,0,0.1);\n        }\n        \n        .pairing-code-input {\n            width: 100%;\n            padding: 15px;\n            font-size: 18px;\n            border: 2px solid #e1e5e9;\n            border-radius: 8px;\n            text-align: center;\n            font-family: monospace;\n            letter-spacing: 2px;\n            text-transform: uppercase;\n            margin: 15px 0;\n        }\n        \n        .btn {\n            width: 100%;\n            padding: 15px;\n            background: #1976D2;\n            color: white;\n            border: none;\n            border-radius: 8px;\n            font-size: 16px;\n            font-weight: 600;\n            cursor: pointer;\n            transition: background-color 0.3s;\n        }\n        \n        .btn:hover {\n            background: #1565C0;\n        }\n        \n        .btn:disabled {\n            background: #ccc;\n            cursor: not-allowed;\n        }\n        \n        .btn.success {\n            background: #4CAF50;\n        }\n        \n        .btn.danger {\n            background: #f44336;\n        }\n        \n        .app-limits {\n            background: white;\n            border-radius: 12px;\n            padding: 20px;\n            margin-bottom: 20px;\n            box-shadow: 0 2px 8px rgba(0,0,0,0.1);\n        }\n        \n        .app-item {\n            display: flex;\n            justify-content: between;\n            align-items: center;\n            padding: 12px 0;\n            border-bottom: 1px solid #f0f0f0;\n        }\n        \n        .app-info {\n            flex: 1;\n        }\n        \n        .app-name {\n            font-weight: 600;\n            color: #333;\n        }\n        \n        .app-limit {\n            font-size: 12px;\n            color: #666;\n        }\n        \n        .app-status {\n            padding: 4px 8px;\n            border-radius: 4px;\n            font-size: 12px;\n            font-weight: 500;\n        }\n        \n        .app-status.active {\n            background: #e8f5e8;\n            color: #2e7d32;\n        }\n        \n        .app-status.blocked {\n            background: #ffebee;\n            color: #c62828;\n        }\n        \n        .logs {\n            background: #1e1e1e;\n            color: #00ff00;\n            padding: 15px;\n            border-radius: 8px;\n            font-family: monospace;\n            font-size: 12px;\n            max-height: 150px;\n            overflow-y: auto;\n            margin-top: 20px;\n        }\n        \n        .hidden {\n            display: none;\n        }\n        \n        h2 {\n            margin-bottom: 15px;\n            color: #333;\n        }\n        \n        h3 {\n            margin-bottom: 10px;\n            color: #666;\n            font-size: 16px;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"device-frame\">\n        <div class=\"screen\">\n            <div class=\"status-bar\">\n                <span>Screen Time Child</span>\n                <div class=\"connection-status\">\n                    <div class=\"status-dot\" id=\"connectionDot\"></div>\n                    <span id=\"connectionText\">Offline</span>\n                </div>\n            </div>\n            \n            <div class=\"content\">\n                <!-- Pairing Section -->\n                <div class=\"pairing-section\" id=\"pairingSection\">\n                    <h2>📱 Device Pairing</h2>\n                    <p>Enter the 6-digit code from your parent's dashboard:</p>\n                    <input type=\"text\" \n                           id=\"pairingCode\" \n                           class=\"pairing-code-input\" \n                           placeholder=\"ABC123\"\n                           maxlength=\"6\">\n                    <button class=\"btn\" id=\"pairBtn\" onclick=\"pairDevice()\">Pair Device</button>\n                </div>\n                \n                <!-- Dashboard Section (hidden initially) -->\n                <div class=\"hidden\" id=\"dashboardSection\">\n                    <div class=\"pairing-section\">\n                        <h2>✅ Device Paired Successfully!</h2>\n                        <p><strong>Device ID:</strong> <span id=\"deviceId\">CHILD-001</span></p>\n                        <p><strong>Child:</strong> <span id=\"childName\">Emma</span></p>\n                        <button class=\"btn danger\" onclick=\"unpairDevice()\">Unpair Device</button>\n                    </div>\n                    \n                    <!-- App Limits -->\n                    <div class=\"app-limits\">\n                        <h3>📱 App Status</h3>\n                        <div id=\"appLimitsList\">\n                            <!-- App limits will be populated here -->\n                        </div>\n                    </div>\n                    \n                    <!-- Earned Minutes -->\n                    <div class=\"pairing-section\">\n                        <h3>🎯 Reward Time Bank</h3>\n                        <p style=\"font-size: 24px; font-weight: bold; color: #4CAF50; text-align: center;\" id=\"earnedMinutes\">0 minutes</p>\n                        <p style=\"text-align: center; color: #666;\">Available bonus screen time</p>\n                    </div>\n                    \n                    <!-- Emergency Status -->\n                    <div class=\"pairing-section hidden\" id=\"emergencyStatus\">\n                        <h3>🚨 Emergency Unlock Active</h3>\n                        <p>Your parent has temporarily unlocked your device.</p>\n                        <p><strong>Time remaining:</strong> <span id=\"emergencyTime\">30:00</span></p>\n                    </div>\n                </div>\n                \n                <!-- Logs -->\n                <div class=\"logs\" id=\"logs\"></div>\n            </div>\n        </div>\n    </div>\n    \n    <script>\n        let socket = null;\n        let deviceId = null;\n        let childId = null;\n        let appLimits = [];\n        let emergencyTimer = null;\n        \n        const BACKEND_URL = 'https://safeweb-kids-1.preview.emergentagent.com';\n        \n        function log(message) {\n            const logs = document.getElementById('logs');\n            const timestamp = new Date().toLocaleTimeString();\n            logs.innerHTML += `[${timestamp}] ${message}\\n`;\n            logs.scrollTop = logs.scrollHeight;\n        }\n        \n        function updateConnectionStatus(connected) {\n            const dot = document.getElementById('connectionDot');\n            const text = document.getElementById('connectionText');\n            \n            if (connected) {\n                dot.classList.remove('offline');\n                text.textContent = 'Connected';\n            } else {\n                dot.classList.add('offline');\n                text.textContent = 'Offline';\n            }\n        }\n        \n        async function pairDevice() {\n            const code = document.getElementById('pairingCode').value.toUpperCase().trim();\n            if (code.length !== 6) {\n                alert('Please enter a valid 6-digit pairing code');\n                return;\n            }\n            \n            log(`Attempting to pair with code: ${code}`);\n            \n            try {\n                const response = await fetch(`${BACKEND_URL}/api/device-control/pair-device`, {\n                    method: 'POST',\n                    headers: {\n                        'Content-Type': 'application/json'\n                    },\n                    body: JSON.stringify({\n                        pairing_code: code,\n                        device_name: 'Child Device Simulator',\n                        platform: 'web',\n                        device_identifier: 'WEB_' + Math.random().toString(36).substr(2, 9),\n                        app_version: '1.0.0'\n                    })\n                });\n                \n                if (response.ok) {\n                    const result = await response.json();\n                    deviceId = result.device_id;\n                    childId = result.child_id;\n                    \n                    log('Device paired successfully!');\n                    showDashboard();\n                    connectWebSocket();\n                } else {\n                    const error = await response.json();\n                    log(`Pairing failed: ${error.detail}`);\n                    alert('Pairing failed: ' + error.detail);\n                }\n            } catch (error) {\n                log(`Connection error: ${error.message}`);\n                alert('Connection error. Please check your internet connection.');\n            }\n        }\n        \n        function showDashboard() {\n            document.getElementById('pairingSection').classList.add('hidden');\n            document.getElementById('dashboardSection').classList.remove('hidden');\n            document.getElementById('deviceId').textContent = deviceId;\n        }\n        \n        function unpairDevice() {\n            if (socket) {\n                socket.disconnect();\n            }\n            \n            deviceId = null;\n            childId = null;\n            appLimits = [];\n            \n            document.getElementById('pairingSection').classList.remove('hidden');\n            document.getElementById('dashboardSection').classList.add('hidden');\n            document.getElementById('pairingCode').value = '';\n            \n            updateConnectionStatus(false);\n            log('Device unpaired');\n        }\n        \n        function connectWebSocket() {\n            log('Connecting to parent dashboard...');\n            \n            socket = io(BACKEND_URL, {\n                transports: ['websocket']\n            });\n            \n            socket.on('connect', () => {\n                log('Connected to parent dashboard');\n                updateConnectionStatus(true);\n                \n                // Register this device\n                socket.emit('device_register', {\n                    device_id: deviceId,\n                    child_id: childId\n                });\n            });\n            \n            socket.on('disconnect', () => {\n                log('Disconnected from parent dashboard');\n                updateConnectionStatus(false);\n            });\n            \n            socket.on('execute_command', (command) => {\n                log(`Received command: ${command.command}`);\n                handleParentCommand(command);\n            });\n        }\n        \n        function handleParentCommand(command) {\n            switch (command.command) {\n                case 'set_app_limits':\n                    appLimits = command.parameters.limits;\n                    updateAppLimitsList();\n                    log(`App limits updated: ${appLimits.length} apps`);\n                    break;\n                    \n                case 'set_downtime':\n                    log('Downtime schedule updated');\n                    // Simulate downtime enforcement\n                    break;\n                    \n                case 'emergency_unlock':\n                    startEmergencyUnlock(command.parameters.duration_minutes);\n                    break;\n                    \n                default:\n                    log(`Unknown command: ${command.command}`);\n            }\n            \n            // Confirm command execution\n            if (socket) {\n                socket.emit('command_executed', {\n                    command: command.command,\n                    status: 'success',\n                    timestamp: new Date().toISOString()\n                });\n            }\n        }\n        \n        function updateAppLimitsList() {\n            const container = document.getElementById('appLimitsList');\n            container.innerHTML = '';\n            \n            if (appLimits.length === 0) {\n                container.innerHTML = '<p style=\"color: #666;\">No app limits set</p>';\n                return;\n            }\n            \n            appLimits.forEach(limit => {\n                const appItem = document.createElement('div');\n                appItem.className = 'app-item';\n                \n                const isBlocked = Math.random() > 0.7; // Random simulation\n                \n                appItem.innerHTML = `\n                    <div class=\"app-info\">\n                        <div class=\"app-name\">${limit.app_name}</div>\n                        <div class=\"app-limit\">Limit: ${limit.daily_limit_minutes} min/day</div>\n                    </div>\n                    <div class=\"app-status ${isBlocked ? 'blocked' : 'active'}\">\n                        ${isBlocked ? 'BLOCKED' : 'ACTIVE'}\n                    </div>\n                `;\n                \n                container.appendChild(appItem);\n            });\n        }\n        \n        function startEmergencyUnlock(durationMinutes) {\n            log(`Emergency unlock activated for ${durationMinutes} minutes`);\n            \n            const emergencyStatus = document.getElementById('emergencyStatus');\n            emergencyStatus.classList.remove('hidden');\n            \n            let timeLeft = durationMinutes * 60; // Convert to seconds\n            \n            emergencyTimer = setInterval(() => {\n                const minutes = Math.floor(timeLeft / 60);\n                const seconds = timeLeft % 60;\n                document.getElementById('emergencyTime').textContent = \n                    `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;\n                \n                timeLeft--;\n                \n                if (timeLeft < 0) {\n                    clearInterval(emergencyTimer);\n                    emergencyStatus.classList.add('hidden');\n                    log('Emergency unlock expired');\n                }\n            }, 1000);\n        }\n        \n        // Simulate earned minutes updates\n        function simulateEarnedMinutes() {\n            const earnedElement = document.getElementById('earnedMinutes');\n            let minutes = parseInt(earnedElement.textContent) || 0;\n            \n            setInterval(() => {\n                if (Math.random() > 0.95) { // 5% chance every interval\n                    minutes += 15;\n                    earnedElement.textContent = `${minutes} minutes`;\n                    log(`Task completed! Earned 15 minutes. Total: ${minutes} minutes`);\n                }\n            }, 5000);\n        }\n        \n        // Initialize\n        log('Screen Time Child Device Simulator loaded');\n        log('Enter pairing code from parent dashboard to connect');\n        updateConnectionStatus(false);\n        simulateEarnedMinutes();\n    </script>\n</body>\n</html>"